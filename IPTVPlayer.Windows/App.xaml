<Application x:Class="IPTVPlayer.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#090B14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#121526" />
        <SolidColorBrush x:Key="CardBrush" Color="#181C31" />
        <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#A78BFA" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5F3FF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#A8A9BC" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#22263E" />
            <Setter Property="BorderBrush" Value="#343956" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15192A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#343956" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#15192A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#343956" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Application.Resources>
</Application>
